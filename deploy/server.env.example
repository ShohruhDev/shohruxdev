# Copy to /etc/web-mobile.env (0600, owned by root).
# Replace placeholders. SITE_URL/SITE_INDEXABLE must also be set during build.
SITE_URL=https://YOUR_DOMAIN
SITE_INDEXABLE=true
CONTENT_DB=/var/lib/web-mobile/content.sqlite
ADMIN_LOCAL_PREVIEW=false
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CONTENT_AUTHOR=Burxonov Shohrux
CONTENT_AUTOMATION_ENABLED=true
CONTENT_MONTHLY_RUN_LIMIT=30
# Set only after API budget/model access are configured.
# OPENAI_API_KEY=
# CONTENT_MODEL=
# Set true ONLY when reverse proxy strips/sets forwarded headers correctly.
TRUST_PROXY=false
