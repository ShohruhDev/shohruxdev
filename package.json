{
  "name": "web-mobile-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.mjs",
    "content": "node --env-file-if-exists=.env scripts/content.mjs",
    "test:integration": "node tests/http.integration.mjs",
    "test:admin": "node tests/admin.integration.mjs",
    "preview:local": "HOST=127.0.0.1 PORT=3000 ADMIN_LOCAL_PREVIEW=true CONTENT_AUTOMATION_ENABLED=true node --env-file-if-exists=.env .output/server/index.mjs",
    "editorial": "node --env-file-if-exists=.env scripts/editorial.mjs",
    "test:bilingual": "node tests/bilingual.integration.mjs",
    "start": "node .output/server/index.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@phosphor-icons/vue": "2.2.1",
    "@resvg/resvg-js": "2.6.2",
    "nuxt": "4.6.2",
    "satori": "0.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
