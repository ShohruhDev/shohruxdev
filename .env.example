# Для первого запуска ничего заполнять не требуется.
SITE_URL=http://127.0.0.1:3000
SITE_INDEXABLE=false
# На production используйте абсолютный путь на постоянном диске.
# CONTENT_DB=/var/lib/web-mobile/content.sqlite
# TRUST_PROXY=false

# Панель /admin. Для сервера задайте уникальные секреты (не коммитить .env).
# ADMIN_PASSWORD=at-least-16-random-characters
# ADMIN_SESSION_SECRET=at-least-32-random-characters
# Только явный локальный предпросмотр; никогда не включайте на публичном сервере.
ADMIN_LOCAL_PREVIEW=false

CONTENT_AUTHOR=Burxonov Shohrux
# Нужны модель с web_search и Structured Outputs и отдельный API-ключ проекта.
# OPENAI_API_KEY=
# CONTENT_MODEL=
CONTENT_MONTHLY_RUN_LIMIT=30
# Долгоживущий Node-сервер: публикация раз в минуту, подготовка после 08:00 UTC+5.
# Подготовка требует ключ+модель; публикация проверенных статей работает без ИИ.
CONTENT_AUTOMATION_ENABLED=false

# IndexNow (Яндекс, Bing): 8–128 символов a-z, A-Z, 0-9, «-». Работает только при SITE_INDEXABLE=true.
# Ключ отдаётся по адресу /<ключ>.txt; при выпуске статей их адреса отправляются автоматически.
# INDEXNOW_KEY=
